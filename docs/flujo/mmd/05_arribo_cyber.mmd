flowchart TD
    A0(["Termina la asignación<br/>ops.sp_arribo_base: foto de pendientes"]) --> A1["Se escribe el SCBSDOS<br/>ARCHIVOS_LISTOS_486: subir el SCBSDOS<br/>(SCBTEL y gescar esperan su paso)"]
    A1 --> U1(["Asignaciones sube el SCBSDOS"])
    U1 --> S{"Saldos arriba (val.txt):<br/>cuentas con DMHOSTUP de hoy<br/>= cuentas del SCBSDOS"}
    S -- no --> SW["ESPERANDO SALDOS<br/>(siguiente vuelta del job)"]
    S -- sí --> S1["ARRIBO SALDOS<br/>se escriben y avisan los gescar<br/>de nuevas y reasignadas"]
    S1 --> T1["Depuración de teléfonos<br/>vacía y carga RCVRY.JSP_TAB_TEL_REMESA_486"]
    T1 --> T2{"¿La remesa en CYBER tiene los mismos<br/>teléfonos que nuestro archivo?<br/>ops.sp_tel_remesa_validar"}
    T2 -- no --> TX["No se ejecuta el store<br/>TEL REMESA VALIDADA ERROR + HALLAZGO_486<br/>no subir el SCBTEL"]
    T2 -- sí --> T3["JSP_TELEFONOS_REMESA_486<br/>inactiva lo que no está en la remesa"]
    T3 --> T4["Se escribe el SCBTEL<br/>ARCHIVOS_LISTOS_486: ya pueden subir el SCBTEL"]
    T4 --> C1["Depuración de correos<br/>correos nuevos → bandera 416 → remesa → JSP_CORREOS_486"]
    T4 --> U2(["Asignaciones sube el SCBTEL<br/>(activa nuestros teléfonos)"])
    U2 --> G{"¿Ya están en PHONE_G1 los teléfonos<br/>que faltaban? (≥ 95 %)"}
    G -- no --> GW["ESPERANDO SCBTEL"]
    G -- sí --> G1["GESCAR SIN TELEFONO<br/>baja teléfonos → SCBACTH_SINTEL.TXT + aviso"]
    C1 --> P["ops.sp_arribo_posterior"]
    G1 --> P
    P --> P1["Blanqueo de status (días 1 a 10)<br/>después de correos OK"]
    P --> P2["Confirmación: teléfonos y correos OK<br/>y gescar sin teléfono hecho → ARRIBO FIN + CONFIRMACION_ASIG_486"]
    C1 -. error .-> H["Bitácora ERROR + HALLAZGO_486<br/>no se reintenta solo"]
    G1 -. error .-> H
